<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launch_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/privacy_consent_surface">

        <TextView
            android:id="@+id/privacy_document_back"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/privacy_document_back"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/privacy_consent_text"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/privacy_document_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/privacy_consent_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFE9EEF2" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/privacy_document_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/privacy_consent_card"
                android:padding="14dp"
                android:textColor="@color/privacy_consent_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/privacy_document_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/privacy_consent_text"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
