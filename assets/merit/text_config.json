{
  "texts": [
    { "id": "calm_c01", "content": "慢一点，也是在认真生活。", "category": "calm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c02", "content": "这一声，替你把心放轻一点。", "category": "calm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c03", "content": "不用马上想通，先好好呼吸。", "category": "warm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c04", "content": "你已经走了很远，可以停一下。", "category": "warm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c05", "content": "把别人的期待，先放在门外。", "category": "calm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c06", "content": "今天的你，也值得被温柔对待。", "category": "warm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c07", "content": "让这一刻，只属于你自己。", "category": "calm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c08", "content": "情绪不是麻烦，它只是想被听见。", "category": "warm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c09", "content": "不赶时间，心会找到自己的节奏。", "category": "calm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_c10", "content": "先照顾自己，再回答这个世界。", "category": "warm", "rarity": "common", "reincarnationTier": 0 },
    { "id": "calm_r01", "content": "愿你不必逞强，也依然被坚定选择。", "category": "warm", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "calm_r02", "content": "风会经过你，也会带走一部分沉重。", "category": "calm", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "calm_r03", "content": "此刻没有答案，也不妨碍你继续被爱。", "category": "warm", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "calm_e01", "content": "星光落在很远的地方，也落在正在坚持的你身上。", "category": "calm", "rarity": "epic", "reincarnationTier": 0 },
    { "id": "sleep_c01", "content": "今天到这里就很好，剩下的明天再说。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c02", "content": "放松肩膀，把呼吸交给夜晚。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c03", "content": "现在不用解决任何问题。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c04", "content": "把今天的遗憾，轻轻放在枕边。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c05", "content": "闭上眼睛，允许世界暂时安静。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c06", "content": "你不必完美地结束这一天。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c07", "content": "晚安不是告别，是给心一个拥抱。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_c08", "content": "今晚先放过自己，好好睡一觉。", "category": "sleep", "rarity": "common", "reincarnationTier": 0 },
    { "id": "sleep_r01", "content": "愿梦替你收好，那些没来得及安放的心事。", "category": "sleep", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "sleep_r02", "content": "月光不会催你，它只陪你慢慢入睡。", "category": "sleep", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "sleep_e01", "content": "夜色正在拥抱你，明天醒来又是新的岸。", "category": "sleep", "rarity": "epic", "reincarnationTier": 0 },
    { "id": "c01", "content": "敲一下，功德-1，老板快乐+1。", "category": "toxic", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c02", "content": "别人敲木鱼求静心，你敲木鱼求加薪。", "category": "absurd", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c03", "content": "木鱼：我又不是 KPI，别敲这么狠。", "category": "absurd", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c04", "content": "今日功德已欠费，请充值摸鱼时长。", "category": "toxic", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c05", "content": "你这不是修行，是带薪发泄。", "category": "scene", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c06", "content": "木鱼都替你尴尬：轻点，同事在看。", "category": "scene", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c07", "content": "八字说你今天宜摆烂，忌内卷。", "category": "bazi", "rarity": "common", "reincarnationTier": 0 },
    { "id": "c08", "content": "财星没亮，敲再响也不会涨工资。", "category": "bazi", "rarity": "common", "reincarnationTier": 0 },
    { "id": "r01", "content": "稀有警告：你的手速已经超越人类编制。", "category": "toxic", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "r02", "content": "木鱼内部评估：你是本周最卷访客。", "category": "scene", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "r03", "content": "系统提示：再敲下去要触发劳动仲裁了。", "category": "absurd", "rarity": "rare", "reincarnationTier": 0 },
    { "id": "e01", "content": "史诗暴击：佛祖看了你的考勤，默默点了举报。", "category": "toxic", "rarity": "epic", "reincarnationTier": 0 },
    { "id": "e02", "content": "史诗暴击：天道批复——准许你继续负功德。", "category": "hidden", "rarity": "epic", "reincarnationTier": 0 },
    { "id": "e03", "content": "史诗暴击：木鱼成精，申请与你签订劳动合同。", "category": "absurd", "rarity": "epic", "reincarnationTier": 0 },
    { "id": "re1_01", "content": "转生专属：上一世的锅，这一世继续背。", "category": "rebirth", "rarity": "rare", "reincarnationTier": 1 },
    { "id": "re1_02", "content": "转生专属：轮回不改摸鱼魂。", "category": "rebirth", "rarity": "common", "reincarnationTier": 1 },
    { "id": "re3_01", "content": "地府篇：孟婆说你汤里加了加班。", "category": "rebirth", "rarity": "rare", "reincarnationTier": 3 },
    { "id": "re5_01", "content": "天庭篇：玉帝批注——此人难管，建议放养。", "category": "rebirth", "rarity": "epic", "reincarnationTier": 5 },
    { "id": "re7_01", "content": "摆烂篇：天道已读不回，你赢了。", "category": "rebirth", "rarity": "epic", "reincarnationTier": 7 },
    { "id": "re10_01", "content": "创世级：你敲的不是木鱼，是服务器。", "category": "hidden", "rarity": "epic", "reincarnationTier": 10 },
    { "id": "hid01", "content": "隐藏款：我命由我不由佛，但佛还是看了我一眼。", "category": "hidden", "rarity": "epic", "reincarnationTier": 0, "hidden": true }
  ]
}
